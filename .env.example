# Django
SECRET_KEY=generate-a-random-64-char-key-with-python-c-import-secrets-print-secrets-token-urlsafe-64
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-domain.com

# Database (MySQL)
DB_NAME=content_tracker
DB_USER=content_tracker_user
DB_PASSWORD=strong-random-password-here
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Firebase Cloud Messaging (optional)
FIREBASE_CREDENTIALS=/path/to/firebase-credentials.json
FCM_DISABLED=1
